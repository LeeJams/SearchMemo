{
  "expo": {
    "name": "MemoFind",
    "slug": "searchmemo",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leejam.searchmemo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#e1f3f5"
      },
      "package": "com.leejam.searchmemo",
      "versionCode": 13
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ab8e887e-d72d-4537-ac62-5c2053dce60b"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#e1f3f5",
          "ios": {
            "image": "./assets/splash.png",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ]
  }
}
